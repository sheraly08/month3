SELECT * FROM products;

SELECT
    p.name,
    p.photo,
    p.price,
    p.product_id,
    pd.category,
    pd.color,
    pd.description
FROM products AS p
INNER JOIN products_detail AS pd
    ON p.product_id = pd.product_id;
